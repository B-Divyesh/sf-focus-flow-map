{
  "name": "focus-flow-map",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:site": "vite --config vite.site.config.ts",
    "build:extension": "wxt build",
    "build:site": "vite build --config vite.site.config.ts",
    "package:extension": "node scripts/package-extension.mjs",
    "build": "npm run clean && npm run build:extension && npm run package:extension && npm run build:site",
    "clean": "node scripts/clean.mjs",
    "test": "vitest run && playwright test",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "1.58.2",
    "archiver": "^7.0.1",
    "sharp": "^0.34.3",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "wxt": "^0.20.11"
  }
}
